# Secrets. The repository is public.
.env

# What a run produces: video, audio, downloaded clips, pictures. Too big for git and
# rebuildable from the database plus the sources.
output/
logs/
*.mp4
*.mp3
*.wav

# ...except the music the videos are scored with. It is CC0, it is small, and a blanket *.mp3
# kept it out of the repository: the runner had no tracks, the render said nothing about it,
# and video 1 went up silent.
!assets/music/*.mp3
!assets/music/*.ogg

# Python
__pycache__/
*.pyc
.pytest_cache/

# The YouTube token, which is a credential even though it is a file.
token.json
credentials.json

# Per-run artifact the email reads; not state.
preflight-problems.txt
secrets/
output/

# Working frames the catalogue builder pulls from stock to show a model; 200 MB and rebuildable.
data/candidate-frames/
data/music-cc0-*.json
output_full/

# Demo covers made by hand while designing; the pipeline writes its own into output/.
output_cover/
